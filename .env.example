# Database
DATABASE_URL="postgresql://user:password@localhost:5432/orderflow?schema=public"

# Supabase Auth
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API
ANTHROPIC_API_KEY=sk-ant-api-your-key

# WhatsApp / Meta Cloud API (webhook verification + notifyOwner template)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_API_VERSION=v18.0
WHATSAPP_TEMPLATE_NAME=nouvelle_commande

# yCloud — outbound messages (formulaire, order confirmation, merchant notifications)
YCLOUD_API_KEY=your-ycloud-api-key
YCLOUD_WHATSAPP_NUMBER=+212XXXXXXXXX

# Server
PORT=3001
