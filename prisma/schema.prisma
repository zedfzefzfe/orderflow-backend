generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum BusinessSector {
  BEAUTE_COSMETIQUES
  MODE_VETEMENTS
  DECORATION_MAISON
  ELECTRONIQUE_HIGH_TECH
  ALIMENTATION_EPICERIE
  SPORT_FITNESS
  BEBE_ENFANT
  BIJOUX_ACCESSOIRES
  AUTRE
}

enum ProductCategory {
  BOUGIES_BOUQUETS
  PARFUMS
  VETEMENTS_MODE
  COSMETIQUES_BEAUTE
  BIJOUX_ACCESSOIRES
  DECORATION_MAISON
  ELECTRONIQUE
  ALIMENTATION
  SPORT_FITNESS
  BEBE_ENFANT
  AUTRE
}

enum MoroccanWilaya {
  CASABLANCA
  RABAT
  MARRAKECH
  FES
  TANGER
  AGADIR
  MEKNES
  OUJDA
  KENITRA
  TETOUAN
  SALE
  TEMARA
  MOHAMMEDIA
  EL_JADIDA
  BENI_MELLAL
  NADOR
  SETTAT
  KHOURIBGA
  SAFI
  LAAYOUNE
  AUTRE
}

enum DeliveryCompany {
  AMANA
  MAYSTRO
  OZONEXPRESS
  CATHEDIS
  SENDIT
  TAWSSIL
  AMEEX
  AUTRE
}

// ── Models ────────────────────────────────────────────────────────────────────

model Business {
  id                          String          @id @default(uuid())
  name                        String
  email                       String?
  whatsappPhoneNumberId        String?         @map("whatsapp_phone_number_id")
  whatsappBusinessAccountId    String?         @map("whatsapp_business_account_id")
  ownerNotifyPhone             String?         @map("owner_notify_phone")
  confirmationTemplate         String?         @map("confirmation_template")
  formulaireTemplate           String?         @map("formulaire_template")
  pushSubscription             String?         @map("push_subscription")
  weeklyReportEnabled          Boolean         @default(true) @map("weekly_report_enabled")
  plan                        String          @default("trial")
  trialEndsAt                 DateTime?       @map("trial_ends_at")
  createdAt                   DateTime        @default(now()) @map("created_at")
  sector                      BusinessSector?  @map("sector")
  wilaya                      MoroccanWilaya?  @map("wilaya")
  city                        String?          @map("city")
  defaultDeliveryCompany      DeliveryCompany? @map("default_delivery_company")
  whatsappInstanceName        String?          @map("whatsapp_instance_name")
  whatsappConnected           Boolean          @default(false) @map("whatsapp_connected")
  whatsappFlowConfig          Json?            @map("whatsapp_flow_config")

  users                User[]
  orders               Order[]
  messageLogs          MessageLog[]
  productCatalog       ProductCatalog[]
  conversationMessages ConversationMessage[]
  customers            Customer[]
  whatsappSessions     WhatsappSession[]
  automations          Automation[]

  @@map("businesses")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  businessId  String   @map("business_id")
  role        String   @default("owner")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("users")
}

enum OrderStatus {
  CONFIRMED
  EN_LIVRAISON
  LIVRE
  RETOURNE
  ANNULE
  DELIVERED
  CANCELLED
}

enum ReturnReason {
  // Client-fault
  INJOIGNABLE
  REFUSE_LIVRAISON
  FAUSSE_COMMANDE
  ANNULE_AVANT_LIVRAISON
  REPORTE_CLIENT
  // Non client-fault
  MAUVAISE_ADRESSE
  PROBLEME_PRODUIT
  AUTRE
}

model Order {
  id            String      @id @default(uuid())
  businessId    String      @map("business_id")
  customerName  String      @map("customer_name")
  customerPhone String      @map("customer_phone")
  product       String
  quantity      Int
  address       String?
  deliveryDate  String?     @map("delivery_date")
  price         Float?      @map("price")
  totalPrice    Float?      @map("total_price")
  deliveryPrice Float?      @map("delivery_price")
  status        OrderStatus @default(CONFIRMED)
  needsReview   Boolean     @default(false) @map("needs_review")
  rawMessage    String      @map("raw_message")
  source        String      @default("whatsapp")
  deliveredAt              DateTime?        @map("delivered_at")
  createdAt                DateTime         @default(now()) @map("created_at")

  estimatedDeliveryAt      DateTime?        @map("estimated_delivery_at")
  confirmationResolved     Boolean          @default(false) @map("confirmation_resolved")
  confirmationResolvedAt   DateTime?        @map("confirmation_resolved_at")
  confirmationSource       String?          @map("confirmation_source")
  returnReason             ReturnReason?    @map("return_reason")
  deliveryAttemptedAt      DateTime?        @map("delivery_attempted_at")
  merchantNotifiedAt       DateTime?        @map("merchant_notified_at")
  escalationTriggeredAt    DateTime?        @map("escalation_triggered_at")

  productCategory          ProductCategory? @map("product_category")
  wilaya                   MoroccanWilaya?  @map("wilaya")
  city                     String?          @map("city")
  deliveryCompany          DeliveryCompany? @map("delivery_company")

  business Business @relation(fields: [businessId], references: [id])

  @@map("orders")
}

model MessageLog {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  fromPhone  String   @map("from_phone")
  body       String
  parsed     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("message_logs")
}

model ProductCatalog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  price      Float
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("product_catalog")
}

model ConversationMessage {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  phone       String
  role        String
  type        String
  content     String
  mediaUrl    String?  @map("media_url")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("conversation_messages")
}

model Customer {
  id                 String          @id @default(uuid())
  phone              String
  businessId         String          @map("business_id")
  names              String[]
  totalOrders        Int             @default(0) @map("total_orders")
  delivered          Int             @default(0)
  clientFaultReturns Int             @default(0) @map("client_fault_returns")
  reporteClient      Int             @default(0) @map("reporte_client")
  legitReturns       Int             @default(0) @map("legit_returns")
  faultPoints        Float           @default(0) @map("fault_points")
  riskScore          Int             @default(0) @map("risk_score")
  riskLevel          String          @default("FIABLE") @map("risk_level")
  lastOrderAt        DateTime?       @map("last_order_at")
  firstOrderAt       DateTime?       @map("first_order_at")
  avgOrderValue      Float?          @map("avg_order_value")
  wilaya             MoroccanWilaya? @map("wilaya")
  city               String?         @map("city")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([phone, businessId])
  @@map("customers")
}

model WhatsappSession {
  id            String   @id @default(cuid())
  businessId    String   @map("business_id")
  phoneNumber   String   @map("phone_number")
  flowCompleted Boolean  @default(false) @map("flow_completed")
  createdAt     DateTime @default(now()) @map("created_at")
  lastMessageAt DateTime @updatedAt @map("last_message_at")

  business Business @relation(fields: [businessId], references: [id])

  @@unique([phoneNumber, businessId])
  @@map("whatsapp_sessions")
}

// One configurable Meta Ads funnel: a pre-filled trigger message the customer
// sends, the photos we reply with, and the welcome script that follows them.
// A business can have several — matched in priority order on first contact.
model Automation {
  id             String   @id @default(cuid())
  businessId     String   @map("business_id")
  name           String
  triggerMessage String   @map("trigger_message") @db.Text
  welcomeMessage String   @map("welcome_message") @db.Text
  photoUrls      String[] @map("photo_urls")
  videoUrl       String?  @map("video_url")
  documentUrls   String[] @default([]) @map("document_urls")
  // Optional follow-ups sent after the media, in order. Null/empty = skipped.
  message2       String?  @map("message_2") @db.Text
  message3       String?  @map("message_3") @db.Text
  isActive       Boolean  @default(true) @map("is_active")
  priority       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@map("automations")
}

model PendingOrder {
  id            String   @id @default(cuid())
  businessId    String
  customerPhone String
  customerName  String?
  phone         String?
  address       String?
  deliveryDate  String?
  product       String?
  price         Float?
  deliveryPrice Float?
  status        String   @default("WAITING_CLIENT_INFO")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
