generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Business {
  id                          String    @id @default(uuid())
  name                        String
  email                       String?
  whatsappPhoneNumberId        String?   @map("whatsapp_phone_number_id")
  whatsappBusinessAccountId    String?   @map("whatsapp_business_account_id")
  ownerNotifyPhone             String?   @map("owner_notify_phone")
  plan                        String    @default("trial")
  trialEndsAt                 DateTime? @map("trial_ends_at")
  createdAt                   DateTime  @default(now()) @map("created_at")

  users                User[]
  orders               Order[]
  messageLogs          MessageLog[]
  productCatalog       ProductCatalog[]
  conversationMessages ConversationMessage[]

  @@map("businesses")
}

model User {
  id          String   @id @default(uuid())
  email       String   @unique
  password    String
  businessId  String   @map("business_id")
  role        String   @default("owner")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("users")
}

enum OrderStatus {
  CONFIRMED
  DELIVERED
  CANCELLED
}

model Order {
  id            String      @id @default(uuid())
  businessId    String      @map("business_id")
  customerName  String      @map("customer_name")
  customerPhone String      @map("customer_phone")
  product       String
  quantity      Int
  address       String?
  deliveryDate  String?     @map("delivery_date")
  price         Float?      @map("price")
  totalPrice    Float?      @map("total_price")
  deliveryPrice Float?      @map("delivery_price")
  status        OrderStatus @default(CONFIRMED)
  needsReview   Boolean     @default(false) @map("needs_review")
  rawMessage    String      @map("raw_message")
  source        String      @default("whatsapp")
  createdAt     DateTime    @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("orders")
}

model MessageLog {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  fromPhone  String   @map("from_phone")
  body       String
  parsed     Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("message_logs")
}

model ProductCatalog {
  id         String   @id @default(cuid())
  businessId String   @map("business_id")
  name       String
  price      Float
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("product_catalog")
}

model ConversationMessage {
  id          String   @id @default(cuid())
  businessId  String   @map("business_id")
  phone       String
  role        String
  type        String
  content     String
  mediaUrl    String?  @map("media_url")
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id])

  @@map("conversation_messages")
}
